// Mini Inbox schema. Source of truth for shapes: docs/diagrams.md (D-006), refined by D-009 to D-016.
//
// Tenancy rules encoded here (CLAUDE.md section 4, multi-tenant-isolation skill):
// - Every tenant table has a non-null tenant_id with an FK to tenants, and an index that leads with tenant_id.
// - Every unique key includes tenant_id.
// - Child rows reference parents with composite keys (tenant_id, parent_id), so the database refuses a
//   link to another tenant's row. All referential actions are Restrict (never SetNull, which would null
//   the shared tenant_id column).
// - IDs are random UUID v4 values generated by Postgres (gen_random_uuid). Customer IDs are never derived
//   from contact data (D-001).
// - Row-level security is added by hand in the `rls` migration. Prisma can't express it.
//
// Lifecycle: conversations.status (OPEN/CLOSED, D-047). Classification: messages.complexity and intent (D-023, D-032).

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  importFileExtension    = "js"
  generatedFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum Mode {
  AI
  HUMAN
}

enum SenderType {
  CUSTOMER
  AI
  HUMAN
  /// Automatic handoff notices shown to the customer (takeover / return to AI).
  SYSTEM
}

/// Conversation lifecycle (D-047). Staff close a conversation; the customer's next message reopens it in AI mode.
enum ConversationStatus {
  OPEN
  CLOSED
}

enum EventType {
  TAKEOVER
  RETURN_TO_AI
  DRAFT_DISCARDED
  AI_REPLY_SENT
  CLOSED
  REOPENED
}

/// Classification of a customer message (D-023). Drives reply priority.
enum Complexity {
  simple
  complex
}

/// Classification of a customer message (D-023). Stored for the dashboard.
enum Intent {
  question
  booking
  complaint
  greeting
  other
}

/// Processing state of a customer message (D-032). Null for AI and HUMAN messages.
enum ReplyStatus {
  PENDING
  REPLIED
  SKIPPED
  FAILED
}

enum LanguagePreference {
  ar
  en
  match_customer
}

/// Global table (the tenancy root). Not subject to RLS; the app role can only read it.
model Tenant {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @db.VarChar(200)
  /// IANA time zone name, e.g. Asia/Riyadh.
  timeZone  String   @map("time_zone") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  persona          PersonaConfig?
  knowledgeEntries KnowledgeEntry[]
  customers        Customer[]
  conversations    Conversation[]
  messages         Message[]
  events           ConversationEvent[]

  @@map("tenants")
}

/// One row per tenant. Edits apply to the next reply; no version history (D-004).
/// Column bounds are a database backstop; the API validates stricter rules (Phase 8).
model PersonaConfig {
  tenantId              String             @id @map("tenant_id") @db.Uuid
  tone                  String             @db.VarChar(500)
  languagePreference    LanguagePreference @map("language_preference")
  /// Free text until plan Q17 decides the allowed values.
  replyType             String             @map("reply_type") @db.VarChar(50)
  replyMaxLength        Int                @map("reply_max_length")
  businessInstructions  String             @map("business_instructions") @db.VarChar(4000)
  outOfKbMessageEn      String             @map("out_of_kb_message_en") @db.VarChar(1000)
  outOfKbMessageAr      String             @map("out_of_kb_message_ar") @db.VarChar(1000)
  outOfHoursMessageEn   String             @map("out_of_hours_message_en") @db.VarChar(1000)
  outOfHoursMessageAr   String             @map("out_of_hours_message_ar") @db.VarChar(1000)
  /// e.g. MON-FRI
  workingDays           String             @map("working_days") @db.VarChar(50)
  workStart             DateTime           @map("work_start") @db.Time(0)
  workEnd               DateTime           @map("work_end") @db.Time(0)
  /// Show the customer a notice when staff take over and when the AI is back.
  handoffNoticesEnabled Boolean            @default(true) @map("handoff_notices_enabled")
  updatedAt             DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("persona_configs")
}

model KnowledgeEntry {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  titleEn   String   @map("title_en") @db.VarChar(200)
  titleAr   String   @map("title_ar") @db.VarChar(200)
  contentEn String   @map("content_en")
  contentAr String   @map("content_ar")
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@map("knowledge_entries")
}

/// One record per (tenant, real person). The same person has a different random ID in each tenant (D-001).
model Customer {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  /// The sender address from the webhook `from` field. Contact data: never logged.
  externalRef String   @map("external_ref") @db.VarChar(320)
  displayName String?  @map("display_name") @db.VarChar(200)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  conversations Conversation[]

  @@unique([tenantId, id])
  @@unique([tenantId, externalRef])
  @@map("customers")
}

/// One conversation per customer per tenant (D-012). Listed by created_at (D-015).
/// Closed by staff and reopened (same row, AI mode) by the customer's next message (D-047).
model Conversation {
  id              String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String             @map("tenant_id") @db.Uuid
  customerId      String             @map("customer_id") @db.Uuid
  mode            Mode               @default(AI)
  modeChangedAt   DateTime?          @map("mode_changed_at") @db.Timestamptz(3)
  status          ConversationStatus @default(OPEN)
  statusChangedAt DateTime?          @map("status_changed_at") @db.Timestamptz(3)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant   Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  customer Customer            @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  messages Message[]
  events   ConversationEvent[]

  @@unique([tenantId, id])
  @@unique([tenantId, customerId])
  @@index([tenantId, createdAt])
  /// The dashboard's Open / Closed tabs.
  @@index([tenantId, status, createdAt])
  @@map("conversations")
}

model Message {
  id                 String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String       @map("tenant_id") @db.Uuid
  conversationId     String       @map("conversation_id") @db.Uuid
  senderType         SenderType   @map("sender_type")
  /// Inbound only; webhook dedupe key per tenant (D-010). Null for AI and HUMAN messages.
  externalId         String?      @map("external_id") @db.VarChar(200)
  /// Message text. Never logged.
  body               String
  /// The inbound message this reply answers. At most one reply per inbound message (D-014).
  inReplyToMessageId String?      @map("in_reply_to_message_id") @db.Uuid
  /// Set by the classifier on customer messages (D-023).
  complexity         Complexity?
  intent             Intent?
  /// Customer messages only: PENDING until replied, skipped (takeover) or failed (D-032).
  replyStatus        ReplyStatus? @map("reply_status")
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  conversation Conversation        @relation(fields: [tenantId, conversationId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  inReplyTo    Message?            @relation("MessageReply", fields: [tenantId, inReplyToMessageId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  reply        Message?            @relation("MessageReply")
  events       ConversationEvent[]

  @@unique([tenantId, id])
  @@unique([tenantId, externalId])
  @@unique([tenantId, inReplyToMessageId])
  @@index([tenantId, conversationId, createdAt])
  /// The order check: is an older message in this conversation still PENDING?
  @@index([tenantId, conversationId, replyStatus])
  @@map("messages")
}

/// Audit trail for takeover, return to AI, discarded drafts and sent AI replies. No message bodies.
model ConversationEvent {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  conversationId String    @map("conversation_id") @db.Uuid
  eventType      EventType @map("event_type")
  messageId      String?   @map("message_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  conversation Conversation @relation(fields: [tenantId, conversationId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  message      Message?     @relation(fields: [tenantId, messageId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, conversationId, createdAt])
  @@map("conversation_events")
}
