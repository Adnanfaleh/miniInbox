{
  "name": "@mini-inbox/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "NestJS HTTP API and inbound webhook.",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm --filter @mini-inbox/database migrate:test && vitest run",
    "test:isolation": "pnpm --filter @mini-inbox/database migrate:test && vitest run"
  },
  "dependencies": {
    "@mini-inbox/config": "workspace:*",
    "@mini-inbox/contracts": "workspace:*",
    "@mini-inbox/database": "workspace:*",
    "@nestjs/common": "12.4.0",
    "@nestjs/core": "12.4.0",
    "@nestjs/platform-express": "12.4.0",
    "bullmq": "6.7.2",
    "ioredis": "6.0.0",
    "nestjs-cls": "7.0.2",
    "nestjs-pino": "5.3.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.12",
    "@nestjs/schematics": "12.0.13",
    "@nestjs/testing": "12.4.0",
    "@swc/core": "1.16.22",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.2",
    "unplugin-swc": "2.0.0",
    "vitest": "5.1.0"
  }
}
