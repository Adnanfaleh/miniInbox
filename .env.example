# Mini Inbox environment. Copy to .env (`pnpm bootstrap` does this on first run).
# Placeholders only. Never put real secrets in this file.

# --- Docker Compose (local development only) ---
POSTGRES_USER=mini_inbox_owner
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=mini_inbox
# Host ports. 5434 avoids clashing with other local Postgres instances (5432, 5433 are common).
POSTGRES_PORT=5434
REDIS_PORT=6379

# Password for app_user, the application role. Created by docker/postgres/init/01-app-role.sh on first
# start of an empty volume. If you change it later, recreate the volume (`docker compose down -v`).
APP_DB_PASSWORD=change-me-app-local-only

# --- Database URLs ---
# Owner role: migrations and seed only. Bypasses row-level security, so the apps never use it.
MIGRATION_DATABASE_URL=postgresql://mini_inbox_owner:change-me-local-only@localhost:5434/mini_inbox
# Application role used by the API and worker. Subject to row-level security.
DATABASE_URL=postgresql://app_user:change-me-app-local-only@localhost:5434/mini_inbox
# Test database, created by docker/postgres/init/00-create-test-db.sql.
TEST_MIGRATION_DATABASE_URL=postgresql://mini_inbox_owner:change-me-local-only@localhost:5434/mini_inbox_test
TEST_DATABASE_URL=postgresql://app_user:change-me-app-local-only@localhost:5434/mini_inbox_test

# --- Redis ---
REDIS_URL=redis://localhost:6379
# BullMQ key prefix (optional, default mini-inbox). Tests use mini-inbox-test.
QUEUE_PREFIX=mini-inbox

# --- AI (Anthropic, through the AI router only) ---
ANTHROPIC_API_KEY=

# With no key, the worker uses the labelled MOCK provider (local development and tests only).
AI_MODEL=
# Jobs processed at once per worker queue.
WORKER_CONCURRENCY=5

# --- Apps ---
API_PORT=3001
# Webhook rate limits per one-minute window (per sender within a tenant, and per tenant overall).
WEBHOOK_RATE_PER_SENDER=30
WEBHOOK_RATE_PER_TENANT=600
WEB_PORT=3000
# Customer simulator (development only): three test customers chatting with the tenants.
CUSTOMER_SIM_PORT=3002
# Used by the dashboard server side to call the API.
API_BASE_URL=http://localhost:3001
# Signs the dashboard's dev-stand-in session cookie (role and tenant). At least 32 characters.
# `pnpm bootstrap` replaces this placeholder with a random value in your local .env.
WEB_SESSION_SECRET=replace-me-with-a-random-string-of-at-least-32-chars
NODE_ENV=development